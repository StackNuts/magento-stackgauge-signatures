        {
            "id": "magecart-btoa-json-card-encode",
            "name": "Base64-encoded JSON of form data (skimmer encoding pattern)",
            "severity": "warning",
            "target": [
                "cms_content",
                "design_config"
            ],
            "pattern_type": "regex",
            "pattern": "/btoa\\s*\\(\\s*unescape\\s*\\(\\s*encodeURIComponent\\s*\\(\\s*JSON\\.stringify\\s*\\(/",
            "description": "Encoding chain seen in Magecart skimmers that Base64-encode a JSON object of card fields before exfiltration. Heuristic: warns for review rather than blocking. Source: https://blog.cyble.com/2022/09/01/highly-evasive-magecart-javascript-skimmer-active-in-the-wild/",
            "source": "https://blog.cyble.com/2022/09/01/highly-evasive-magecart-javascript-skimmer-active-in-the-wild/",
            "test_should_match": [
                "var d = btoa(unescape(encodeURIComponent(JSON.stringify(fields))));"
            ],
            "test_should_not_match": [
                "var d = JSON.stringify(fields);"
            ]
        },
        {
            "id": "magecart-xhr-prototype-override",
            "name": "XMLHttpRequest prototype override (request interception)",
            "severity": "warning",
            "target": [
                "cms_content",
                "design_config"
            ],
            "pattern_type": "regex",
            "pattern": "/XMLHttpRequest\\.prototype\\.(?:open|send)\\s*=/",
            "description": "Skimmers override XHR send/open to read payment requests as they leave the page. Some legitimate monitoring and polyfill scripts do this too, so this is a warning for review. Source: https://sansec.io/research/svg-onload-magecart-skimmer",
            "source": "https://sansec.io/research/svg-onload-magecart-skimmer",
            "test_should_match": [
                "XMLHttpRequest.prototype.send = function (body) { steal(body); };"
            ],
            "test_should_not_match": [
                "var x = new XMLHttpRequest(); x.open('GET', '/api');"
            ]
        },
        {
            "id": "webshell-eval-strrev-post",
            "name": "eval() of reversed POST input (obfuscated webshell)",
            "severity": "critical",
            "target": [
                "pub_php"
            ],
            "pattern_type": "regex",
            "pattern": "/eval\\s*\\(\\s*\\$\\w+\\s*\\(\\s*strrev\\s*\\(\\s*\\$_POST/",
            "description": "Webshell that reverses a POST value and passes it to a base64 decoder inside eval(). The function name is often split into string fragments to evade literal matching. Source: https://sansec.io/research/magento-xml-backdoor",
            "source": "https://sansec.io/research/magento-xml-backdoor",
            "test_should_match": [
                "<?php @eval($f(strrev($_POST[\"x\"]))); ?>"
            ],
            "test_should_not_match": [
                "<?php echo strrev($_POST[\"x\"]); ?>"
            ]
        },
