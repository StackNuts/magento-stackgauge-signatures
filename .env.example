# Copy to .env (git-ignored) and fill in. Used by scripts/propose_signatures.php for local testing.
# In GitHub Actions, these come from repo secrets instead (see README).

# Cloudflare Workers AI (https://dash.cloudflare.com). The API token needs "Workers AI: Read".
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# Tavily search API key (https://app.tavily.com).
# Brave Search API key (https://api-dashboard.search.brave.com). Optional alongside Tavily.
BRAVE_SEARCH_API_KEY=

TAVILY_API_KEY=

# Optional: override the Workers AI model (default @cf/meta/llama-3.3-70b-instruct-fp8-fast).
# WORKERS_AI_MODEL=
